# Wallet that receives the $0.01 payments (public address only — never a
# private key or seed phrase). Must be on the same network as NETWORK below.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Network: "eip155:84532" = Base Sepolia testnet (safe default, no real money),
#          "eip155:8453"  = Base mainnet (real USDC — go-live only).
NETWORK=eip155:84532

# x402 facilitator. The official docs are explicit: https://x402.org/facilitator
# is for testnet development ONLY. For mainnet, point this at a production
# facilitator, e.g. https://facilitator.payai.network
# (Coinbase CDP: https://api.cdp.coinbase.com/platform/v2/x402 — check their
# docs for any API-key requirement).
FACILITATOR_URL=https://x402.org/facilitator

# Local port
PORT=4021
